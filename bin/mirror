#!/bin/bash
# mirror — manage Claude Cowork project mirroring between two Macs.
#
#   Setup verbs run from this repo. Runtime verbs are delegated to the versioned
#   engine deployed in the shared tree (see bin/VERSIONING.md for why it is
#   versioned rather than edited in place).
#
#   THE DAILY PAIR — one verb per side, both block until the transfer is provable:
#
#   mirror send <Project> --to <Machine> [--note ...] [--wait]
#                                    materialize, manifest, ownership event, then wait
#                                    until every file is actually UPLOADED (--wait also
#                                    waits for the other Mac to claim it)
#   mirror receive <Project>         wait for the handoff, md5-verify every file against
#                                    the manifest, define the project here if needed,
#                                    claim it, and copy the handoff doc to the clipboard
#
#   mirror use-root <path>           set the shared drive root for THIS Mac
#   mirror deploy                    install/refresh tooling into the shared tree
#   mirror migrate <Project>         move a local project INTO the shared tree
#   mirror path <Project>            print the shared folder path (also copies it)
#   mirror link <Project>            DEPRECATED — symlinks break Cowork folder grants
#   mirror rename <Old> <New>        rename a shared project everywhere
#
#   mirror hold <Project> --to <M>   lock THIS Mac out of a project it handed away:
#                                    unlinks the folder and puts a notice in the
#                                    project's instructions (send --hold does both)
#   mirror release <Project>         undo that (receive does it automatically)
#
#   mirror project-list              local projects defined on THIS Mac
#   mirror project-export <Name>     write a project definition into the shared tree
#   mirror project-import <Name>     add an exported definition to THIS Mac
#                                    --wait blocks until the definition AND its files land
#   mirror wait <Name>               watch the drive deliver a project, with progress
#   mirror project-repath <Name> <p> repoint a project's folder
#   mirror check                     report state, change nothing
#
#   mirror status                    who owns what
#   mirror handoff <Project> --to <Machine> [--note ...] [--wait]   (send does this + more)
#   mirror pickup [Project]                                         (receive does this + more)
#   mirror log <Project>
#   mirror conflicts
#   mirror materialize [path]

set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONF="$HOME/.config/claude-macos-mirror/root"
# Original folder paths, stashed while a project is held. Deliberately LOCAL and never
# in spaces.json: the app rewrites that file from memory and may drop keys it does not
# know, which would strand the project with no folder and no way back.
HOLDDIR="$HOME/.config/claude-macos-mirror/held"
default_root(){ echo "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Claude"; }
resolve_root(){
  if [ -n "${MIRROR_ROOT:-}" ]; then echo "$MIRROR_ROOT"
  elif [ -f "$CONF" ]; then
    local r; r="$(sed -e 's/[[:space:]]*$//' -e '/^$/d' "$CONF" | head -1)"
    echo "${r/#\~/$HOME}"
  else default_root; fi
}
ROOT="$(resolve_root)"
PROJECTS="$ROOT/Projects"
HANDOFF="$ROOT/_handoff"
EVENTS="$HANDOFF/events"
ME="$(scutil --get ComputerName 2>/dev/null || hostname)"

die(){ echo "error: $*" >&2; exit 1; }
ok(){ echo "  ✓ $*"; }

engine(){
  local e
  e="$(ls -1 "$HANDOFF"/bin/coworkctl-v*.sh 2>/dev/null | sort -V | tail -1)"
  [ -n "$e" ] || die "no engine deployed yet — run: mirror deploy"
  echo "$e"
}

# print the leading comment block, stopping at the first non-comment line
usage(){ awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "${BASH_SOURCE[0]}"; }

cmd_use_root(){
  local path="${1:-}"; [ -n "$path" ] || die "usage: mirror use-root <path-to-shared-folder>"
  path="${path/#\~/$HOME}"
  local parent; parent="$(dirname "$path")"
  [ -d "$parent" ] || die "parent does not exist: $parent
     Make sure the shared drive is mounted and synced first."
  mkdir -p "$(dirname "$CONF")"
  printf '%s\n' "$path" > "$CONF"
  ok "shared root for $ME set to: $path"
  echo "  (stored in $CONF — this is per-machine, so the two Macs may differ)"
}

cmd_deploy(){
  local parent; parent="$(dirname "$ROOT")"
  [ -d "$parent" ] \
    || die "shared drive not available at: $parent
     Mount/sync the drive, or point elsewhere:  mirror use-root <path>"
  mkdir -p "$PROJECTS" "$HANDOFF/bin"
  ok "tree ready: $ROOT"
  for f in "$HERE"/bin/coworkctl-v*.sh; do
    [ -f "$f" ] || continue
    cp "$f" "$HANDOFF/bin/$(basename "$f")"; chmod +x "$HANDOFF/bin/$(basename "$f")"
    ok "deployed $(basename "$f")"
  done
  [ -f "$HERE/bin/VERSIONING.md" ] && cp "$HERE/bin/VERSIONING.md" "$HANDOFF/bin/README.md" && ok "deployed bin/README.md"
  if command -v zip >/dev/null 2>&1; then
    local tmp; tmp="$(mktemp -d)"
    for k in handoff pickup; do
      [ -f "$HERE/skills/$k/SKILL.md" ] || continue
      mkdir -p "$tmp/$k"; cp -R "$HERE/skills/$k/." "$tmp/$k/"
      (cd "$tmp" && rm -f "$HANDOFF/$k.skill" && zip -q -D -r "$HANDOFF/$k.skill" "$k" -x '.*')
      ok "packaged $k.skill"
    done
    rm -rf "$tmp"
  else
    echo "  ! zip not found — skill bundles not packaged"
  fi
  echo
  echo "Note: the engine and skill bundles live inside the shared tree, so the OTHER Mac"
  echo "receives them through the shared drive automatically. The 'mirror' CLI itself"
  echo "travels by git, so run 'git pull' over there after changing it."
  echo "On the other Mac you need 'mirror use-root' only if its shared path differs;"
  echo "projects arrive with 'mirror receive <Project>'."
}

cmd_check(){
  echo "machine: $ME"
  echo "shared root: $ROOT"
  [ -f "$CONF" ] && echo "  (from $CONF)" || echo "  (default — no config set)"
  case "$ROOT" in
    *CloudDocs*) echo "iCloud account: $(defaults read MobileMeAccounts Accounts 2>/dev/null | awk -F'"' '/AccountID/{print $2; exit}')";;
  esac
  [ -d "$ROOT" ] && ok "shared tree present" || echo "  ✗ shared tree missing (drive not synced yet?)"
  local e; e="$(ls -1 "$HANDOFF"/bin/coworkctl-v*.sh 2>/dev/null | sort -V | tail -1)"
  # no `xargs basename` — the path contains spaces
  [ -n "$e" ] && ok "engine: $(basename "$e")" || echo "  ✗ engine not deployed"
  echo "  shared projects:"
  for d in "$PROJECTS"/*/; do [ -d "$d" ] && echo "      $(basename "$d")"; done
  echo "  granted folders that will fail in Cowork:"
  python3 - <<'PY'
import json,glob,os
fs=[x for x in glob.glob(os.path.expanduser(
    "~/Library/Application Support/Claude/local-agent-mode-sessions/*/*/spaces.json"))
    if "skills-plugin" not in x]
bad=0
for f in fs:
    try: d=json.load(open(f))
    except Exception: continue
    for s in d.get("spaces",[]):
        for x in s.get("folders") or []:
            p=x.get("path","")
            if os.path.islink(p):
                bad+=1
                print(f'      ✗ {s["name"]} — granted folder is a SYMLINK')
                print(f'          granted: {p}')
                print(f'          real:    {os.path.realpath(p)}')
                print(f'          fix: mirror project-repath "{s["name"]}" "{os.path.realpath(p)}"')
            elif not os.path.exists(p):
                bad+=1
                shared=os.path.expanduser(
                    "~/Library/Mobile Documents/com~apple~CloudDocs/Claude/Projects/"+s["name"])
                print(f'      ✗ {s["name"]} — granted folder DOES NOT EXIST')
                print(f'          granted: {p}')
                if os.path.isdir(shared):
                    print(f'          shared copy is at: {shared}')
                    print(f'          fix: mirror project-repath "{s["name"]}" "{shared}"')
                else:
                    print(f'          no shared copy found — was it migrated?')
if not bad: print("      none ✓")
PY
  return 0   # a successful report must exit 0; the loop above can leave $? non-zero
}

# Prints the shared path, and copies it, for the cases where a human still needs the
# string: attaching a folder by hand in the picker, or checking what a project points at.
# The normal path is that migrate/project-import/project-repath write it for you.
cmd_path(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: mirror path <Project>"
  [ -d "$PROJECTS/$name" ] || die "'$name' is not in the shared tree ($PROJECTS)"
  echo "$PROJECTS/$name"
  # Only hijack the clipboard when a human is reading this. Inside a command
  # substitution -- cd "$(mirror path X)" -- stdout is a pipe, and copying there would
  # silently overwrite the handoff document that 'mirror receive' just put on the
  # clipboard, so the next paste lands a path instead of the brief.
  if [ -t 1 ] && command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$PROJECTS/$name" | pbcopy
    echo "  (copied to clipboard — only needed for a hand grant: Add folder, Cmd-Shift-G, paste)" >&2
  fi
}

# Kept only to explain itself. Creating the symlink is what broke folder links.
cmd_link(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: mirror link <Project>"
  [ -d "$PROJECTS/$name" ] || die "'$name' is not in the shared tree ($PROJECTS)"
  echo "mirror link is deprecated and creates nothing."
  echo
  echo "Cowork registers a symlinked folder as \"connected\" and then fails every read"
  echo "inside it with \"is not inside a folder connected to Cowork on this device\","
  echo "because the resolved real path falls outside the connected scope. The folder"
  echo "looks fine in the UI, which makes it hard to diagnose. Verified 2026-08-19."
  echo
  echo "Point the project at the real path instead — with Claude quit, no picker needed:"
  echo "    mirror project-repath \"$name\" \"$PROJECTS/$name\""
  echo
  echo "It is the same path on both Macs, so there is nothing to link."
}

cmd_migrate(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: mirror migrate <Project>"
  local src="$HOME/Documents/Claude/Projects/$name"
  local dst="$PROJECTS/$name"
  [ -e "$src" ] || die "no such project: $src"
  [ -L "$src" ] && { ok "'$name' is already a symlink into the shared tree"; return 0; }
  [ -d "$src" ] || die "$src is not a directory"
  [ -e "$dst" ] && die "'$name' already exists in the shared tree.
     This Mac picks it up instead of migrating:  mirror receive \"$name\""

  echo "migrating '$name' into the shared tree"
  mkdir -p "$dst"
  rsync -a --exclude '.DS_Store' "$src/" "$dst/" || die "copy failed"
  ok "copied"
  local a b
  a="$(cd "$src" && find . -type f ! -name '.DS_Store' -exec md5 -q {} \; -print | paste - - | sort)"
  b="$(cd "$dst" && find . -type f ! -name '.DS_Store' -exec md5 -q {} \; -print | paste - - | sort)"
  if [ "$a" != "$b" ]; then
    echo "VERIFICATION FAILED — nothing moved." >&2
    diff <(echo "$a") <(echo "$b") | head -20 >&2
    die "refusing to move the original"
  fi
  ok "verified $(echo "$a" | grep -c .) files identical by md5"
  local bak="$HOME/Documents/Claude/Projects/.$name.pre-icloud-$(date +%Y%m%d-%H%M%S)"
  mv "$src" "$bak" || die "could not move original aside"
  ok "original preserved at $bak"

  # Moving the original breaks this project's folder link, which still points at the
  # old path. Repair it here rather than leaving the user with a project that silently
  # cannot read its own files. Writing spaces.json IS the grant -- verified 2026-08-20,
  # a project linked this way and never touched in the picker reads fine.
  if pgrep -f "Claude.app/Contents/MacOS/Claude" >/dev/null 2>&1; then
    echo
    echo "  ⚠ Claude is running, so the folder grant could not be updated automatically."
    echo "    '$name' still points at the path that was just moved, and will fail to read"
    echo "    its files until this is fixed. Quit Claude, then run:"
    echo "        mirror project-repath \"$name\" \"$dst\""
  else
    cmd_project_repath "$name" "$dst" >/dev/null 2>&1 \
      && ok "folder grant repointed at the shared copy" \
      || echo "  ! could not repoint the grant — run: mirror project-repath \"$name\" \"$dst\""
  fi
  echo
  echo "  NO symlink is created, deliberately. Cowork registers a symlinked folder as"
  echo "  \"connected\" but then refuses every read inside it, because the resolved real"
  echo "  path is outside the connected scope. Verified 2026-08-19."
  echo
  echo "  If the folder was repointed above, just relaunch Claude — macOS may prompt once"
  echo "  for access to this location. No folder picker step: the project already points"
  echo "  at the shared copy."
  echo "      $dst"
  echo
  echo "  That path is identical on both Macs. Keep the backup until Cowork reads the"
  echo "  project successfully."
}

# Rename a shared project everywhere: the folder, its ownership history, and this
# Mac's symlink. Useful when the folder name does not match the Cowork project name.
cmd_rename(){
  local old="${1:-}" new="${2:-}"
  [ -n "$old" ] && [ -n "$new" ] || die "usage: mirror rename <Old> <New>"
  [ -d "$PROJECTS/$old" ] || die "'$old' is not in the shared tree"
  [ -e "$PROJECTS/$new" ] && die "'$new' already exists in the shared tree"

  echo "renaming shared project: '$old' -> '$new'"
  mv "$PROJECTS/$old" "$PROJECTS/$new" || die "rename failed"
  ok "folder renamed"

  if [ -d "$EVENTS/$old" ]; then
    if [ -e "$EVENTS/$new" ]; then
      echo "  ! events/$new already exists — leaving events/$old in place"
    else
      mv "$EVENTS/$old" "$EVENTS/$new"; ok "ownership history moved"
    fi
  fi

  local link="$HOME/Documents/Claude/Projects/$old"
  if [ -L "$link" ]; then rm "$link"; ok "removed stale symlink $link"; fi

  # The rename broke this Mac's folder link -- it still names the old path. Repair it
  # here rather than sending the user to the file picker; writing spaces.json IS the
  # grant. Only the app being open stops us.
  if pgrep -f "Claude.app/Contents/MacOS/Claude" >/dev/null 2>&1; then
    echo "  ⚠ Claude is running, so the folder link could not be updated. Quit it, then:"
    echo "        mirror project-repath \"$new\" \"$PROJECTS/$new\""
  else
    cmd_project_repath "$new" "$PROJECTS/$new" >/dev/null 2>&1 \
      && ok "folder link repointed at the renamed folder" \
      || echo "  ! could not repoint — run: mirror project-repath \"$new\" \"$PROJECTS/$new\""
  fi

  echo
  echo "  On your OTHER Mac, once iCloud catches up (Claude quit there too):"
  echo "        mirror project-repath \"$new\" \"$PROJECTS/$new\""
  echo "        rm ~/Documents/Claude/Projects/\"$old\"     # only if a stale symlink is there"
  echo "  Ownership history follows the rename; 'mirror log \"$new\"' should show it."
}

# ---- checkout lock ----------------------------------------------------------
#
# A handed-off project still sits on this Mac, fully readable, and nothing in iCloud
# stops you editing it. Two writers to one synced folder fork rather than merge, so the
# ownership log needs teeth on the sending side.
#
# Two spaces.json writes do it, both per-machine and both reversible:
#   1. a banner prepended to the project's instructions. Verified 2026-08-20: a local
#      project's instructions land verbatim in the Cowork session's systemPrompt, so
#      the assistant reads the notice before you type and can refuse.
#   2. folders[] emptied, so the session cannot read a byte even if it ignores the
#      banner.
# The banner is wrapped in markers that export and import always strip -- otherwise
# "CHECKED OUT TO Ji-su" would travel TO Ji-su on the next send.
HOLD_OPEN="<!-- mirror:hold -->"
HOLD_CLOSE="<!-- /mirror:hold -->"

cmd_hold(){
  local name="" to=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="${2:-}"; shift 2;;
      *)    [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: mirror hold <Project> --to <Machine>"
  require_claude_quit
  local f; f="$(spaces_file)" || die "no spaces.json on this Mac"
  mkdir -p "$HOLDDIR"
  cp "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"
  python3 - "$f" "$name" "${to:-the other Mac}" "$HOLDDIR/$name.json" "$HOLD_OPEN" "$HOLD_CLOSE" <<'PY'
import json,sys,os,datetime
dst,name,to,stash,OPEN,CLOSE=sys.argv[1:7]
d=json.load(open(dst))
e=next((x for x in d.get("spaces",[]) if x.get("name")==name),None)
if e is None: print(f'no local project named "{name}"',file=sys.stderr); sys.exit(1)
folders=e.get("folders") or []
if not folders and os.path.exists(stash):
    print(f'  "{name}" is already held'); sys.exit(0)
json.dump({"project":name,"folders":folders,
           "held_at":datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ"),
           "to":to}, open(stash,"w"), indent=2)
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%MZ")
banner=(f"{OPEN}\n"
  f"CHECKED OUT TO {to} since {ts}.\n"
  f"This machine does NOT hold this project. Do not create, edit, move or delete any\n"
  f"file in the project folder -- {to} is working in it, and two writers to one synced\n"
  f"folder produce conflict copies, not merges. If you are asked to change anything\n"
  f"here, refuse and say the project is checked out to {to}.\n"
  f'To bring it back, the user runs in a terminal:  mirror receive "{name}"\n'
  f"{CLOSE}\n\n")
instr=e.get("instructions") or ""
import re
instr=re.sub(re.escape(OPEN)+r".*?"+re.escape(CLOSE)+r"\n*","",instr,flags=re.S)
e["instructions"]=banner+instr
e["folders"]=[]
json.dump(d,open(dst,"w"),indent=2)
print(f'  "{name}" held for {to}')
print(f'      folder unlinked ({len(folders)} path(s) stashed) — Cowork here can read nothing')
print(f'      notice added to the project instructions — sessions here will refuse to edit')
PY
  echo "  Relaunch Claude. Release it with:  mirror release \"$name\"   (or 'mirror receive')"
}

cmd_release(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: mirror release <Project>"
  require_claude_quit
  local f; f="$(spaces_file)" || die "no spaces.json on this Mac"
  cp "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"
  python3 - "$f" "$name" "$HOLDDIR/$name.json" "$PROJECTS/$name" "$HOLD_OPEN" "$HOLD_CLOSE" <<'PY'
import json,sys,os,re
dst,name,stash,fallback,OPEN,CLOSE=sys.argv[1:7]
d=json.load(open(dst))
e=next((x for x in d.get("spaces",[]) if x.get("name")==name),None)
if e is None: print(f'no local project named "{name}"',file=sys.stderr); sys.exit(1)
instr=e.get("instructions") or ""
had=OPEN in instr
e["instructions"]=re.sub(re.escape(OPEN)+r".*?"+re.escape(CLOSE)+r"\n*","",instr,flags=re.S)
folders=e.get("folders") or []
if not folders:
    if os.path.exists(stash):
        folders=json.load(open(stash)).get("folders") or []
    if not folders:
        folders=[{"path":fallback}]      # canonical shared path; mirror always uses it
    e["folders"]=folders
json.dump(d,open(dst,"w"),indent=2)
if os.path.exists(stash): os.remove(stash)
print(f'  "{name}" released' + ('' if had else ' (no hold notice was present)'))
for x in e["folders"]: print(f'      folder: {x.get("path")}')
PY
  echo "  Relaunch Claude."
}

# ---- local project definitions (spaces.json) --------------------------------
#
# A project with a folder attached is machine-bound: it lives in this Mac's
# spaces.json and never reaches the web or the other Mac. The file is plain JSON,
# so a project CAN be copied -- export it into the shared tree here, import it
# there. What does not come across is the conversation history; that is what the
# handoff document carries.
#
# All of these refuse to run while Claude is open, because a live app rewrites
# spaces.json from memory and would discard the edit.

spaces_file(){
  local f
  for f in "$HOME/Library/Application Support/Claude/local-agent-mode-sessions"/*/*/spaces.json; do
    case "$f" in *skills-plugin*) continue;; esac
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 1
}

# A manifest of the project's files, so the receiving Mac can show real progress and
# verify on arrival rather than guessing when the drive is "done". Written by both
# project-export and send; `wait_for_files` reads whichever is newest.
write_manifest(){
  local name="$1"
  mkdir -p "$HANDOFF/projects"
  python3 - "$PROJECTS/$name" "$HANDOFF/projects" "$name" <<'PY'
import os,sys,json,hashlib
import datetime
root,outdir,name=sys.argv[1],sys.argv[2],sys.argv[3]
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
dest=os.path.join(outdir,f"{name}.{ts}.manifest.json")
files=[]
for dp,_,fn in os.walk(root):
    if ".handoff" in dp.split(os.sep): continue
    for f in fn:
        if f==".DS_Store": continue
        fp=os.path.join(dp,f); rel=os.path.relpath(fp,root)
        try:
            h=hashlib.md5(open(fp,"rb").read()).hexdigest()
            files.append({"path":rel,"size":os.path.getsize(fp),"md5":h})
        except OSError: pass
json.dump({"project":name,"files":files,
           "count":len(files),"bytes":sum(f["size"] for f in files)},
          open(dest,"w"),indent=2)
print(f'  manifest: {len(files)} files, {sum(f["size"] for f in files)/1000:.1f} KB')
PY
}

# Newest ownership event as: verb, machine, to, at, doc. Non-zero if there is none.
# Filenames lead with the UTC timestamp, so sorting them is sorting by time.
newest_event(){
  python3 - "$PROJECTS/$1/.handoff/events" <<'PY'
import os,sys,json,glob
fs=sorted(glob.glob(os.path.join(sys.argv[1],"*.json")))
if not fs: sys.exit(1)
try: e=json.load(open(fs[-1]))
except Exception: sys.exit(1)
print("\t".join([e.get("verb",""),e.get("machine",""),e.get("to","") or "",
                 e.get("at",""),e.get("handoff_doc","") or ""]))
PY
}

# Does THIS Mac already define the project? Decides whether receive has to touch
# spaces.json at all -- and therefore whether Claude must be quit.
have_project(){
  local f; f="$(spaces_file)" || return 1
  python3 - "$f" "$1" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))
sys.exit(0 if any(x.get("name")==sys.argv[2] for x in d.get("spaces",[])) else 1)
PY
}

# newest exported definition for a project, or empty. Timestamped names sort last;
# the bare <Name>.json is the pre-timestamp layout.
find_definition(){
  local name="$1" src
  src="$(ls -1 "$HANDOFF/projects/$name."*.json 2>/dev/null | grep -v '\.manifest\.json$' | sort | tail -1)"
  [ -n "$src" ] || { [ -f "$HANDOFF/projects/$name.json" ] && src="$HANDOFF/projects/$name.json"; }
  echo "$src"
}

require_claude_quit(){
  if pgrep -f "Claude.app/Contents/MacOS/Claude" >/dev/null 2>&1; then
    die "Claude is running. Quit it first — a live app rewrites spaces.json from memory
     and will silently discard this change."
  fi
}

cmd_project_list(){
  local f; f="$(spaces_file)" || die "no spaces.json found (has Cowork ever run on this Mac?)"
  python3 - "$f" <<'PY'
import json,sys,os
d=json.load(open(sys.argv[1]))
sp=d.get("spaces",[])
print(f"{len(sp)} local project(s) on this Mac:")
for x in sp:
    paths=[p.get("path") for p in (x.get("folders") or [])]
    bad=[p for p in paths if not os.path.exists(p)]
    print(f'  {x["name"]}')
    for p in paths:
        print(f'      {"✗" if p in bad else "•"} {p}')
PY
}

cmd_project_export(){
  local name="${1:-}"; [ -n "$name" ] || die "usage: mirror project-export <Name>"
  local f; f="$(spaces_file)" || die "no spaces.json on this Mac"
  mkdir -p "$HANDOFF/projects"
  python3 - "$f" "$name" "$HANDOFF/projects" <<'PY'
import json,sys,os
src,name,outdir=sys.argv[1],sys.argv[2],sys.argv[3]
d=json.load(open(src))
e=next((x for x in d.get("spaces",[]) if x["name"]==name),None)
if e is None:
    print(f'no local project named "{name}". Try: mirror project-list',file=sys.stderr); sys.exit(1)
out=dict(e)
# A hold banner is about THIS Mac's checkout state. Shipping it would tell the other
# Mac its own project is checked out to itself, in its system prompt, forever.
import re
_open,_close="<!-- mirror:hold -->","<!-- /mirror:hold -->"
if out.get("instructions"):
    out["instructions"]=re.sub(re.escape(_open)+r".*?"+re.escape(_close)+r"\n*","",
                               out["instructions"],flags=re.S)
# folder paths are per-machine; the importer sets its own
out["folders"]=[]
out["_exported_from_paths"]=[p.get("path") for p in (e.get("folders") or [])]
# NEW file each time, never an overwrite: the drive does not reliably propagate an
# in-place modification of a file the other Mac has already read. Same reason the
# engine filename carries a version and the event log is append-only.
import datetime
ts=datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
dest=os.path.join(outdir,f"{name}.{ts}.json")
json.dump(out,open(dest,"w"),indent=2)
print(f'  exported "{name}" -> _handoff/projects/{name}.{ts}.json')
print(f'  instructions: {"yes" if e.get("instructions") else "none"}')
PY
  write_manifest "$name"
  echo "  The other Mac picks it up with:  mirror project-import \"$name\""
}

cmd_project_import(){
  require_claude_quit
  local name="" wait=0 timeout=600
  while [ $# -gt 0 ]; do
    case "$1" in
      --wait)    wait=1; shift;;
      --timeout) timeout="${2:-}"; shift 2;;
      *)         [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: mirror project-import <Name> [--wait] [--timeout SECONDS]"
  local src; src="$(find_definition "$name")"
  if [ "$wait" = 1 ]; then
    local start=$SECONDS
    if [ -z "$src" ]; then
      echo "waiting for the definition to arrive from the other Mac..."
      while [ $((SECONDS-start)) -lt "$timeout" ]; do
        ls "$HANDOFF" >/dev/null 2>&1; ls "$HANDOFF/projects" >/dev/null 2>&1
        src="$(find_definition "$name")"
        [ -n "$src" ] && { echo "  arrived after ~$((SECONDS-start))s"; break; }
        printf "\r  %ds" $((SECONDS-start)); sleep 6
      done
      echo
      [ -n "$src" ] || die "the definition never arrived (waited ${timeout}s).
     Run 'mirror project-export \"$name\"' on the other Mac, and check it is awake."
    fi
    # The definition is a few hundred bytes and lands first. The FILES are the slow part,
    # and they arrive DATALESS -- listed at full size with no content -- so only a read
    # materializes them. Importing before that gives Cowork a project whose files read
    # empty, with nothing to indicate why. Same loop `mirror wait` uses; md5-verified.
    local left=$(( timeout - (SECONDS - start) ))
    [ "$left" -lt 60 ] && left=60
    echo "waiting for the project's files..."
    wait_for_files "$name" "$left" || die "the files did not all arrive — nothing was imported.
     Re-run when the other Mac is awake, or import the definition alone with
     'mirror project-import \"$name\"' and materialize later with 'mirror wait \"$name\"'."
  fi
  [ -n "$src" ] && [ -f "$src" ] || die "no exported definition for \"$name\" in $HANDOFF/projects
     Run 'mirror project-export \"$name\"' on the other Mac first, and give the drive time to sync."
  local f; f="$(spaces_file)" || die "no spaces.json on this Mac (open Cowork once to create it)"
  cp "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"
  python3 - "$f" "$src" "$PROJECTS" <<'PY'
import json,sys,os
dst,src,projects=sys.argv[1],sys.argv[2],sys.argv[3]
d=json.load(open(dst)); e=json.load(open(src))
e.pop("_exported_from_paths",None)
import re
_open,_close="<!-- mirror:hold -->","<!-- /mirror:hold -->"
if e.get("instructions"):   # defensive: a definition exported by an older mirror
    e["instructions"]=re.sub(re.escape(_open)+r".*?"+re.escape(_close)+r"\n*","",
                             e["instructions"],flags=re.S)
name=e["name"]
if any(x.get("id")==e.get("id") or x.get("name")==name for x in d.get("spaces",[])):
    print(f'  "{name}" already exists on this Mac — nothing to do'); sys.exit(0)
# always the shared path -- never ~/Documents, which is usually a symlink and
# a symlinked grant registers as connected then fails every read.
path = os.path.join(projects, name)
e["folders"]=[{"path":path}]
d.setdefault("spaces",[]).insert(0,e)
json.dump(d,open(dst,"w"),indent=2)
print(f'  added "{name}"')
print(f'  folder: {path}' + ('' if os.path.exists(path) else '   <-- not delivered yet; mirror receive will wait for it'))
PY
  echo "  Relaunch Claude. The project appears with its name and instructions."
  echo "  Its chat history will be empty — that is expected; the handoff document carries"
  echo "  the context, and 'mirror receive' hands it to you."
}

cmd_project_repath(){
  require_claude_quit
  local name="${1:-}" path="${2:-}"
  [ -n "$name" ] && [ -n "$path" ] || die "usage: mirror project-repath <Name> <folder-path>"
  path="${path/#\~/$HOME}"
  [ -e "$path" ] || die "no such path: $path"
  local f; f="$(spaces_file)" || die "no spaces.json on this Mac"
  cp "$f" "$f.bak-$(date +%Y%m%d-%H%M%S)"
  python3 - "$f" "$name" "$path" <<'PY'
import json,sys
dst,name,path=sys.argv[1],sys.argv[2],sys.argv[3]
d=json.load(open(dst))
e=next((x for x in d.get("spaces",[]) if x["name"]==name),None)
if e is None: print(f'no local project named "{name}"',file=sys.stderr); sys.exit(1)
old=[p.get("path") for p in (e.get("folders") or [])]
e["folders"]=[{"path":path}]
json.dump(d,open(dst,"w"),indent=2)
print(f'  "{name}" folders: {old} -> [{path}]')
PY
  echo "  Relaunch Claude for it to take effect."
}

# Watch the shared drive deliver a project, with progress. Entirely local -- it polls
# this Mac's own disk. The parent-chain enumeration matters: iCloud does not push to
# an idle Mac, and listing only the leaf directory will not surface new files.
# Shared by `mirror wait` and `mirror project-import --wait`; returns non-zero on
# timeout or md5 mismatch so callers can refuse to proceed.
wait_for_files(){
  local name="$1" timeout="$2"
  local man
  man="$(ls -1 "$HANDOFF/projects/$name."*.manifest.json 2>/dev/null | sort | tail -1)"
  [ -n "$man" ] || man="$HANDOFF/projects/$name.manifest.json"   # pre-timestamp layout
  python3 - "$PROJECTS" "$name" "$man" "$timeout" "$HANDOFF" <<'PY'
import os,sys,json,time,hashlib
projects,name,man,timeout,handoff=sys.argv[1],sys.argv[2],sys.argv[3],int(sys.argv[4]),sys.argv[5]
root=os.path.join(projects,name)

def enumerate_chain():
    # touching each level is what makes the drive surface new entries
    for d in (handoff,os.path.join(handoff,"projects"),projects,root,
              os.path.join(root,".handoff"),os.path.join(root,".handoff","events")):
        try: os.listdir(d)
        except OSError: pass

def present(pull=True):
    """Survey the project. Files arrive DATALESS -- listed with the right size but no
    content -- and nothing materializes them except a read. So this reads anything not
    yet materialized rather than waiting for a state that would never arrive on its own."""
    out={}
    for dp,_,fn in os.walk(root):
        if ".handoff" in dp.split(os.sep): continue
        for f in fn:
            if f==".DS_Store": continue
            fp=os.path.join(dp,f)
            try: st=os.stat(fp)
            except OSError: continue
            if pull and st.st_size>0 and st.st_blocks==0:
                try:
                    with open(fp,"rb") as fh:
                        while fh.read(1<<20): pass
                    st=os.stat(fp)
                except OSError: pass
            out[os.path.relpath(fp,root)]=(st.st_size, st.st_blocks>0)
    return out

expected=None
if os.path.exists(man):
    try: expected=json.load(open(man))
    except Exception: pass

start=time.time(); last=""
while time.time()-start<timeout:
    enumerate_chain()
    p=present()
    have=len(p); mat=sum(1 for v in p.values() if v[1]); byts=sum(v[0] for v in p.values())
    el=int(time.time()-start)
    if expected:
        n=expected["count"]; tb=expected["bytes"]
        pct=int(100*mat/n) if n else 100
        bar="█"*(pct//5)+"░"*(20-pct//5)
        line=f"  [{bar}] {pct:3d}%  {mat}/{n} files materialized, {byts/1000:.0f}/{tb/1000:.0f} KB   {el}s"
    else:
        line=f"  {have} files present, {mat} materialized, {byts/1000:.0f} KB   {el}s"
    if line!=last: print("\r"+line,end="",flush=True); last=line
    if expected and mat>=expected["count"]:
        print()
        bad=[]
        for f in expected["files"]:
            fp=os.path.join(root,f["path"])
            try:
                if hashlib.md5(open(fp,"rb").read()).hexdigest()!=f["md5"]: bad.append(f["path"])
            except OSError: bad.append(f["path"])
        if bad:
            print(f"  {len(bad)} file(s) differ from the manifest:")
            for b in bad[:5]: print(f"      {b}")
            sys.exit(1)
        print(f'  ✓ all {expected["count"]} files delivered and verified by md5 in {el}s')
        sys.exit(0)
    # no manifest: settle for two quiet rounds
    if not expected and have and mat==have:
        time.sleep(6); enumerate_chain()
        if len(present(pull=False))==have:
            print(f"\n  ✓ {have} files present and materialized ({el}s); no manifest, so unverified")
            sys.exit(0)
    time.sleep(3)
print(f"\n  timed out after {timeout}s — the other Mac may be asleep, or the drive is still working")
sys.exit(1)
PY
}

# Wait until the drive has actually UPLOADED the project, not merely stored it locally.
# `isUploaded` from fileproviderctl is the only signal that works on a FileProvider-backed
# iCloud Drive: brctl status returns "Client zone not found", and mdls reports the
# kMDItemUbiquitous* keys as null. Measured 2026-08-20: a fresh 25MB file reads
# isUploaded=0 and flips to 1 after ~110s. Do NOT use isUploading -- it stayed 0 for
# that entire upload. Includes .handoff/, because the ownership event is the part that
# tells the other Mac it owns the project.
wait_uploaded(){
  local name="$1" timeout="$2" man
  man="$(ls -1 "$HANDOFF/projects/$name."*.manifest.json 2>/dev/null | sort | tail -1)"
  python3 - "$PROJECTS/$name" "$timeout" "$man" <<'PY'
import os,sys,subprocess,re,time
root,timeout,man=sys.argv[1],int(sys.argv[2]),sys.argv[3]

def files():
    out=[]
    for dp,_,fn in os.walk(root):
        for f in fn:
            if f==".DS_Store": continue
            out.append(os.path.join(dp,f))
    if man and os.path.exists(man): out.append(man)
    return out

def uploaded(p):
    try:
        o=subprocess.run(["fileproviderctl","evaluate",p],capture_output=True,
                         text=True,timeout=30).stdout
    except Exception:
        return None
    m=re.search(r"isUploaded = (\d+);",o)
    return None if m is None else m.group(1)=="1"

fs=files()
if not fs: print("  no files to upload"); sys.exit(0)
probe=uploaded(fs[0])
if probe is None:
    print("  ! this drive does not report upload state — cannot verify the upload here.")
    print("    Delivery is still proven by the other Mac claiming the project.")
    sys.exit(2)

start=time.time(); last=""
while time.time()-start<timeout:
    fs=files()
    pending=[f for f in fs if uploaded(f) is not True]
    el=int(time.time()-start)
    pct=int(100*(len(fs)-len(pending))/len(fs)) if fs else 100
    bar="█"*(pct//5)+"░"*(20-pct//5)
    line=f"  [{bar}] {pct:3d}%  {len(fs)-len(pending)}/{len(fs)} files uploaded   {el}s"
    if line!=last: print("\r"+line,end="",flush=True); last=line
    if not pending:
        print(f"\n  ✓ all {len(fs)} files uploaded to the drive in {el}s"); sys.exit(0)
    time.sleep(5)
print(f"\n  {len(pending)} file(s) still not uploaded after {timeout}s:")
for f in pending[:5]: print(f"      {os.path.relpath(f,root)}")
sys.exit(1)
PY
}

# One verb for the whole send side: materialize, manifest, ownership event, and then
# proof that the bytes actually left this Mac. Replaces migrate/project-export/handoff/
# materialize as a daily flow, and adds the upload check that had no equivalent.
cmd_send(){
  local name="" to="" note="" doc="" nodoc=0 wait_ack=0 force=0 hold=0 timeout=900
  while [ $# -gt 0 ]; do
    case "$1" in
      --to)      to="${2:-}"; shift 2;;
      --note)    note="${2:-}"; shift 2;;
      --doc)     doc="${2:-}"; shift 2;;
      --no-doc)  nodoc=1; shift;;
      --wait)    wait_ack=1; shift;;
      --hold)    hold=1; shift;;
      --force)   force=1; shift;;
      --timeout) timeout="${2:-}"; shift 2;;
      *)         [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: mirror send <Project> --to <Machine> [--note ...] [--doc FILE] [--no-doc] [--hold] [--force] [--wait]"
  [ -n "$to" ]   || die "--to <Machine> is required — name the Mac receiving this work"
  [ "$to" = "$ME" ] && die "--to is this Mac ($ME) — send to the other one"
  [ -d "$PROJECTS/$name" ] || die "'$name' is not in the shared tree ($PROJECTS)
     Move it there first:  mirror migrate \"$name\""

  local e; e="$(engine)" || exit 1
  grep -q -- '--doc)' "$e" || die "the deployed engine is too old for this (no --doc).
     Refresh it:  mirror deploy"

  # Do not send what this Mac does not hold. receive refuses to claim a project that was
  # not handed to it; without the mirror-image check here, a forgotten handoff could be
  # re-sent from under the Mac that already claimed it -- both Macs then believe they own
  # it, which is precisely how iCloud conflict copies get made.
  if [ "$force" = 0 ] && ev="$(newest_event "$name")"; then
    IFS=$'\t' read -r verb machine evto at _doc <<< "$ev"
    local owner="$machine"; [ "$verb" = "handoff" ] && owner="$evto"
    if [ "$owner" != "$ME" ]; then
      if [ "$verb" = "handoff" ] && [ "$machine" = "$ME" ]; then
        echo "  note: re-sending — $ME handed '$name' to $evto at $at and it was never claimed"
      else
        die "'$name' is held by '$owner', not $ME (newest event: $verb by $machine at $at).
     $owner may be editing it right now; sending would leave both Macs believing they own it.
     Look first:  mirror log \"$name\"
     If you are certain it is stale:  mirror send \"$name\" --to $to --force"
      fi
    fi
  fi

  # Context first. Files without the reasoning behind them is the failure this repo
  # exists to prevent, so refuse rather than quietly ship a bare folder.
  if [ "$nodoc" = 0 ]; then
    if [ -n "$doc" ]; then
      [ -f "$PROJECTS/$name/$doc" ] || die "no such handoff document: $doc"
    else
      doc="$(cd "$PROJECTS/$name" && ls -t HANDOFF*.md 2>/dev/null | head -1)"
      [ -n "$doc" ] || die "no HANDOFF*.md in '$name' — nothing would carry the context.
     Run /handoff in the Cowork session that did the work; it writes the document.
     To send the files anyway:  mirror send \"$name\" --to $to --no-doc"
    fi
    # A document older than the last handoff event is almost certainly the previous
    # topic's, left in the folder. Warn -- the user may genuinely be resending.
    if ev="$(newest_event "$name")"; then
      IFS=$'\t' read -r _v _m _t at _d <<< "$ev"
      python3 - "$PROJECTS/$name/$doc" "$at" <<'PY' || true
import os,sys,datetime
p,at=sys.argv[1],sys.argv[2]
try: ev=datetime.datetime.strptime(at,"%Y%m%dT%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
except Exception: sys.exit(0)
mt=datetime.datetime.fromtimestamp(os.path.getmtime(p),datetime.timezone.utc)
if mt<ev: print(f"  ! {os.path.basename(p)} is older than the last handoff event ({at}) — stale topic?")
PY
    fi
  fi

  echo "sending '$name': $ME -> $to"
  [ -n "$doc" ] && echo "  document: $doc" || echo "  document: none (--no-doc)"
  echo "materializing (so real bytes exist to upload):"
  bash "$e" materialize "$PROJECTS/$name" || echo "  (proceeding despite warnings)"
  # Ship the project definition alongside the files, so the first receive on a Mac that
  # has never seen this project can define it without a separate project-export. Both
  # this and the manifest are written as NEW timestamped files, never overwritten --
  # iCloud does not reliably propagate an in-place edit the peer has already cached.
  if have_project "$name"; then
    cmd_project_export "$name" | sed -n '/exported/p;/instructions:/p;/manifest:/p'
  else
    echo "  ! '$name' is not defined as a project on this Mac — sending files only"
    write_manifest "$name"
  fi
  # array, not ${doc:+--doc "$doc"} -- that form collapses to a single argument under
  # shells that do not word-split unquoted expansions, and this file gets sourced.
  local -a docarg=(); [ -n "$doc" ] && docarg=(--doc "$doc")
  bash "$e" handoff "$name" --to "$to" --note "$note" "${docarg[@]}" \
    | sed -n '/^event:/p;/^  note:/p'
  echo "verifying the upload (this is what 'staged' never proved):"
  local up=0; wait_uploaded "$name" "$timeout" || up=$?
  [ "$up" = 1 ] && die "the upload did not finish — do NOT edit '$name' here.
     Re-run 'mirror send' when the network settles; the event is already recorded."

  if [ "$hold" = 1 ]; then
    echo
    if pgrep -f "Claude.app/Contents/MacOS/Claude" >/dev/null 2>&1; then
      echo "  ⚠ Claude is running, so this Mac was NOT locked out of '$name'."
      echo "    Quit Claude, then:  mirror hold \"$name\" --to $to"
    else
      cmd_hold "$name" --to "$to"
    fi
  fi

  echo
  if [ "$up" = 2 ]; then
    echo "  STAGED (upload state unavailable on this drive). '$to' pulls it with:"
  else
    echo "  UPLOADED. '$to' can pull it now:"
  fi
  echo "      mirror receive \"$name\""
  echo "  Do not edit '$name' on $ME until it comes back."

  if [ "$wait_ack" = 1 ]; then
    echo
    echo "waiting for $to to claim it (Ctrl-C to stop)..."
    local start=$SECONDS
    while [ $((SECONDS-start)) -lt "$timeout" ]; do
      ls "$PROJECTS/$name/.handoff/events" >/dev/null 2>&1
      if ev="$(newest_event "$name")"; then
        IFS=$'\t' read -r verb machine _to at _doc <<< "$ev"
        [ "$verb" = "claim" ] && [ "$machine" = "$to" ] && {
          echo "  ✓ DELIVERED — $to claimed '$name' at $at"; return 0; }
      fi
      printf "\r  %ds" $((SECONDS-start)); sleep 10
    done
    echo
    echo "  no claim after ${timeout}s — $to is probably asleep. It lands when it wakes."
  fi
}

# The receive side, in one verb: wait for the event, verify every file against the
# manifest, define the project here if this Mac has never seen it, claim it, and put
# the handoff document on the clipboard so the Cowork session is one paste away.
cmd_receive(){
  local name="" timeout=900
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="${2:-}"; shift 2;;
      *) [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: mirror receive <Project> [--timeout SECONDS]"
  local e; e="$(engine)" || exit 1
  local start=$SECONDS

  # 1. the ownership event addressed to this Mac
  echo "receiving '$name' on $ME"
  local ev verb machine to at doc ready=0
  if ev="$(newest_event "$name")"; then
    IFS=$'\t' read -r verb machine to at doc <<< "$ev"
    { [ "$verb" = "handoff" ] && [ "$to" = "$ME" ]; } && ready=1
    { [ "$verb" = "claim" ] && [ "$machine" = "$ME" ]; } && ready=2
  fi
  if [ "$ready" = 0 ]; then
    echo "waiting for a handoff addressed to $ME..."
    while [ $((SECONDS-start)) -lt "$timeout" ]; do
      ls "$HANDOFF" >/dev/null 2>&1; ls "$PROJECTS" >/dev/null 2>&1
      ls "$PROJECTS/$name" >/dev/null 2>&1; ls "$PROJECTS/$name/.handoff/events" >/dev/null 2>&1
      if ev="$(newest_event "$name")"; then
        IFS=$'\t' read -r verb machine to at doc <<< "$ev"
        { [ "$verb" = "handoff" ] && [ "$to" = "$ME" ]; } && { ready=1; break; }
        { [ "$verb" = "claim" ] && [ "$machine" = "$ME" ]; } && { ready=2; break; }
      fi
      printf "\r  %ds" $((SECONDS-start)); sleep 6
    done
    echo
  fi
  # Never claim a project that was not handed to this Mac -- that is how both Macs end
  # up believing they own it, which is exactly what produces iCloud conflict copies.
  case "$ready" in
    1) echo "  handed off by $machine at $at";;
    2) echo "  already claimed by $ME at $at — re-verifying and refreshing the document";;
    *) die "no handoff to $ME arrived for '$name' within ${timeout}s.
     Newest event: ${verb:-none} ${machine:+by $machine}${to:+ -> $to} ${at:-}
     Check the sender ran: mirror send \"$name\" --to $ME   (and that the name matches
     'scutil --get ComputerName' over there), or look at: mirror status";;
  esac

  # 2. every file, verified against the manifest -- an un-uploaded file is ABSENT here,
  #    not dataless, so a listing alone can never tell you the transfer was complete.
  local left=$(( timeout - (SECONDS - start) )); [ "$left" -lt 60 ] && left=60
  echo "waiting for the files:"
  wait_for_files "$name" "$left" || die "the files did not all arrive — nothing was claimed.
     Re-run when $machine is awake; 'mirror status' shows who holds it."

  # 3. define the project here if this Mac has never seen it (the only step needing a quit)
  if have_project "$name"; then
    echo "  project already defined on this Mac"
  else
    local def; def="$(find_definition "$name")"
    if [ -z "$def" ]; then
      # A folder in the shared tree that is not a Cowork project on the sender -- a
      # plumbing test, or files shared without a project. Verified and claimed all the
      # same; there is simply nothing to define here. Failing now would throw away a
      # transfer that already checked out by md5.
      echo "  ! no project definition was sent — files only"
      echo "    ('$name' is not a Cowork project on the sending Mac, so there is none to add)"
    else
      require_claude_quit
      cmd_project_import "$name" | sed '/mirror pickup/d'
      [ "${PIPESTATUS[0]}" -eq 0 ] || die "could not add the project definition"
    fi
  fi

  # 4. claim it, and show the document
  bash "$e" pickup "$name" || die "could not claim '$name'"

  # 5. if this Mac locked itself out when it sent the project away, undo that now
  if [ -f "$HOLDDIR/$name.json" ]; then
    if pgrep -f "Claude.app/Contents/MacOS/Claude" >/dev/null 2>&1; then
      echo
      echo "  ⚠ '$name' is still locked on this Mac and Claude is running."
      echo "    Quit Claude, then:  mirror release \"$name\""
    else
      cmd_release "$name"
    fi
  fi

  # 6. the whole point of the trip: get that document into the Cowork session
  if [ -n "$doc" ] && [ -f "$PROJECTS/$name/$doc" ] && command -v pbcopy >/dev/null 2>&1; then
    pbcopy < "$PROJECTS/$name/$doc"
    echo
    echo "  ✓ $doc copied to the clipboard — open '$name' in Cowork and paste it."
  fi
}

cmd_wait(){
  local name="" timeout=600
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="${2:-}"; shift 2;;
      *) [ -n "$name" ] || name="$1"; shift;;
    esac
  done
  [ -n "$name" ] || die "usage: mirror wait <Project> [--timeout SECONDS]"
  wait_for_files "$name" "$timeout"
}

case "${1:-help}" in
  send)     shift; cmd_send "$@";;
  hold)     shift; cmd_hold "$@";;
  release)  shift; cmd_release "$@";;
  receive)  shift; cmd_receive "$@";;
  use-root) shift; cmd_use_root "$@";;
  deploy)   shift; cmd_deploy "$@";;
  check)    shift; cmd_check "$@";;
  link)     shift; cmd_link "$@";;
  path)     shift; cmd_path "$@";;
  migrate)  shift; cmd_migrate "$@";;
  rename)   shift; cmd_rename "$@";;
  project-list)   shift; cmd_project_list "$@";;
  project-export) shift; cmd_project_export "$@";;
  project-import) shift; cmd_project_import "$@";;
  project-repath) shift; cmd_project_repath "$@";;
  wait)           shift; cmd_wait "$@";;
  status|handoff|pickup|log|conflicts|materialize)
            e="$(engine)" || exit 1; exec bash "$e" "$@";;
  help|-h|--help) usage;;
  *) echo "unknown command: $1" >&2; echo; usage; exit 1;;
esac
